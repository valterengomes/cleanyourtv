<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- The island's pills and tabs (docs/ui/launcher/SPEC.md section 5): 36dp, 15dp padding, 14sp next to a 15dp icon;
         cream with ink text when focused. Island sets the icon size and drops the label at rest. -->
    <style name="IslandPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/lw_island_pill</item>
        <item name="android:textColor">@color/lw_on_cream</item>
        <item name="android:drawableTint">@color/lw_on_cream</item>
        <item name="android:drawablePadding">7dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:singleLine">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- A remote key named in a hint: 20dp high, 12sp. -->
    <style name="IslandKeycap">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:minWidth">20dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/lw_keycap</item>
        <item name="android:textColor">@color/lw_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- What a hint's key does: 12sp text3. -->
    <style name="IslandHint">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:textColor">@color/lw_text3</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@string/font_regular</item>
    </style>

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

</resources>
