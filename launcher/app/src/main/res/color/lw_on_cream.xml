<?xml version="1.0" encoding="utf-8"?>
<!-- Island pills, tabs, cards and buttons: ink text and icons on the cream focus fill, cream otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/lw_ink" />
    <item android:color="@color/lw_text" />
</selector>
