<?xml version="1.0" encoding="utf-8"?>
<!-- A remote key named in a hint ("OK", "Back"): lineStrong outline, 20dp high; an ink outline on a focused cream pill
     (the live activity's OK). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#660B0C0E" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/lw_line_strong" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
