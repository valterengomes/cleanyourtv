<?xml version="1.0" encoding="utf-8"?>
<!-- A button inside an island card: cream when focused, a cream hairline otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lw_cream" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/lw_line_strong" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
