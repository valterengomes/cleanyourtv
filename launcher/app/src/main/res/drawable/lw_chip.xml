<?xml version="1.0" encoding="utf-8"?>
<!-- A filter chip: cream when focused, outlined when it is the chosen filter, panel2 otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lw_cream" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/lw_line_strong" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lw_panel2" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
