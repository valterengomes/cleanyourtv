<?xml version="1.0" encoding="utf-8"?>
<!-- A switch that is on: the ok green track with the knob at the end. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lw_ok" />
            <corners android:radius="10dp" />
            <size android:width="36dp" android:height="20dp" />
        </shape>
    </item>
    <item android:gravity="end|center_vertical" android:end="3dp" android:width="14dp" android:height="14dp">
        <shape android:shape="oval">
            <solid android:color="@color/lw_ink" />
        </shape>
    </item>
</layer-list>
