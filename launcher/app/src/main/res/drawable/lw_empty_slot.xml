<?xml version="1.0" encoding="utf-8"?>
<!-- A free dock place (docs/ui/launcher board 13): a dashed lineStrong outline; cream when focused (Add favourites). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/lw_cream" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/lw_line_strong" android:dashWidth="6dp" android:dashGap="4dp" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
