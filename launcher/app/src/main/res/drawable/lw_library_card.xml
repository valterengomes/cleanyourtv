<?xml version="1.0" encoding="utf-8"?>
<!-- An app in the library: an icon on a panel2 card; focus adds a 2dp cream rim. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lw_panel2" />
            <stroke android:width="2dp" android:color="@color/lw_cream" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lw_panel2" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
