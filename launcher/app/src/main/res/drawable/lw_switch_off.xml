<?xml version="1.0" encoding="utf-8"?>
<!-- A switch that is off: a lineStrong outline with the knob at the start. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="@color/lw_text3" />
            <corners android:radius="10dp" />
            <size android:width="36dp" android:height="20dp" />
        </shape>
    </item>
    <item android:gravity="start|center_vertical" android:start="4dp" android:width="12dp" android:height="12dp">
        <shape android:shape="oval">
            <solid android:color="@color/lw_text3" />
        </shape>
    </item>
</layer-list>
